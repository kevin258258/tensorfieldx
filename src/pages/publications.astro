---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryShelf from '../components/EntryShelf.astro';
import { getCollection } from 'astro:content';
const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const entries = publications.map(({ data }) => ({
  title: data.title,
  description: data.abstract ?? '',
  tags: data.tags ?? [],
  image: data.image,
  year: data.year,
  meta: `${data.authors.join(', ')} · ${data.venue}`,
  href: data.pdf || (data.doi ? `https://doi.org/${data.doi}` : undefined),
}));
---
<BaseLayout title="Publications"><EntryShelf entries={entries} title="Publications" description="Academic papers & research outputs." previewLabel="Research" linkLabel="Read paper" emptyText="tbd" /></BaseLayout>
