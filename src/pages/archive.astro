---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryShelf from '../components/EntryShelf.astro';
import { getArchiveEntries } from '../lib/archive';
const entries = (await getArchiveEntries()).map(entry => ({ ...entry, meta: entry.category }));
---
<BaseLayout shelf title="Archive"><EntryShelf entries={entries} title="Archive" description="Writing, projects & experiments." previewLabel="Selected entry" linkLabel="View entry" filters /></BaseLayout>
