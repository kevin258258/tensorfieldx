---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');

const notes = allNotes.map(note => ({
    slug: note.slug,
    title: note.data.title,
    description: note.data.description,
    pubDate: note.data.pubDate.toISOString(),
    tags: note.data.tags || [],
    series: note.data.series,
    seriesOrder: note.data.seriesOrder,
}));

const seriesGroups: Record<string, typeof notes> = {};
const singles: typeof notes = [];
notes.forEach(note => {
    if (note.series) {
        if (!seriesGroups[note.series]) seriesGroups[note.series] = [];
        seriesGroups[note.series].push(note);
    } else {
        singles.push(note);
    }
});
Object.values(seriesGroups).forEach(g => g.sort((a, b) => (a.seriesOrder || 0) - (b.seriesOrder || 0)));

const notesForGraph = JSON.stringify(notes.map(n => ({
    slug: n.slug,
    data: { title: n.title, description: n.description, pubDate: n.pubDate, tags: n.tags, series: n.series, seriesOrder: n.seriesOrder }
})));
---

<BaseLayout title="Research Notes">
    <div class="max-w-4xl mx-auto px-6 py-16 min-h-screen">

        <header class="mb-14">
            <h1 class="text-4xl md:text-5xl font-display font-bold text-primary tracking-tight mb-4">
                Notes
            </h1>
            <p class="text-secondary font-body text-base max-w-xl leading-relaxed">
                Technical derivations and theoretical explorations in physics, mathematics, and computer science.
            </p>
        </header>

        <div class="w-full min-h-[400px]">
            <div class="flex justify-end mb-8 border-b pb-3 border-edge">
                <div class="flex gap-1 text-xs font-sans">
                    <button id="view-list" class="px-3 py-1.5 rounded-md transition-colors text-accent bg-accent/8">
                        List
                    </button>
                    <button id="view-graph" class="px-3 py-1.5 rounded-md transition-colors text-muted">
                        Graph
                    </button>
                </div>
            </div>

            <div id="notes-list" class="space-y-1">
                {Object.entries(seriesGroups).map(([seriesName, seriesNotes]) => (
                    <div class="rounded-lg overflow-hidden border border-edge">
                        <button
                            class="series-toggle w-full flex items-center gap-3 px-4 py-3.5 transition-colors text-left group hover:bg-primary/[0.02]"
                            data-series={seriesName}
                        >
                            <svg class="w-4 h-4 transition-transform text-muted series-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path d="m9 18 6-6-6-6" />
                            </svg>
                            <span class="font-display text-base font-semibold flex-1 text-secondary">
                                {seriesName}
                            </span>
                            <span class="font-mono text-[10px] px-2 py-0.5 rounded text-muted bg-primary/[0.04]">
                                {seriesNotes.length}
                            </span>
                        </button>
                        <div class="series-content hidden border-t border-edge">
                            {seriesNotes.map(note => (
                                <a
                                    href={`/notes/${note.slug}`}
                                    data-astro-prefetch="viewport"
                                    class="flex items-baseline gap-4 py-3 transition-colors rounded-md px-4 pl-12 hover:bg-accent/5"
                                >
                                    <span class="font-mono text-[11px] w-24 shrink-0 text-muted">
                                        {note.pubDate.split('T')[0]}
                                    </span>
                                    <span class="font-body text-[15px] text-primary/85">
                                        {note.title}
                                    </span>
                                    {note.seriesOrder != null && note.seriesOrder > 0 && (
                                        <span class="text-[10px] font-mono ml-auto text-muted">
                                            #{note.seriesOrder}
                                        </span>
                                    )}
                                </a>
                            ))}
                        </div>
                    </div>
                ))}
                {singles.map(note => (
                    <a
                        href={`/notes/${note.slug}`}
                        data-astro-prefetch="viewport"
                        class="flex items-baseline gap-4 py-3 transition-colors rounded-md px-4 hover:bg-accent/5"
                    >
                        <span class="font-mono text-[11px] w-24 shrink-0 text-muted">
                            {note.pubDate.split('T')[0]}
                        </span>
                        <span class="font-body text-[15px] text-primary/85">
                            {note.title}
                        </span>
                    </a>
                ))}
            </div>

            <div id="graph-container" class="hidden" data-notes={notesForGraph}></div>
        </div>

    </div>
</BaseLayout>

<script>
    async function loadNotesGraph(graphEl: HTMLElement) {
        if (graphEl.dataset.graphLoaded === 'true') return;

        graphEl.dataset.graphLoaded = 'true';
        graphEl.innerHTML = '<div class="flex items-center justify-center h-64 text-muted"><span class="font-mono text-xs">Loading graph...</span></div>';

        const { default: KnowledgeGraph } = await import('../../components/KnowledgeGraph') as any;
        const { createElement } = await import('react') as any;
        const { createRoot } = await import('react-dom/client') as any;
        const notesData = JSON.parse(graphEl.dataset.notes || '[]');
        const root = createRoot(graphEl);
        root.render(createElement(KnowledgeGraph, { notes: notesData }));
    }

    function initNotesPage() {
        const listBtn = document.getElementById('view-list');
        const graphBtn = document.getElementById('view-graph');
        const listEl = document.getElementById('notes-list');
        const graphEl = document.getElementById('graph-container');
        if (!listBtn || !graphBtn || !listEl || !graphEl) return;

        document.querySelectorAll('.series-toggle').forEach(btn => {
            (btn as HTMLButtonElement).onclick = () => {
                const content = btn.nextElementSibling as HTMLElement;
                const arrow = btn.querySelector('.series-arrow') as SVGElement;
                const isOpen = !content.classList.contains('hidden');
                content.classList.toggle('hidden');
                arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(90deg)';
                (btn as HTMLElement).style.backgroundColor = isOpen ? '' : 'rgb(var(--color-accent) / 0.04)';
                btn.querySelector('.font-display')!.classList.toggle('text-primary', !isOpen);
                btn.querySelector('.font-display')!.classList.toggle('text-secondary', isOpen);
                if (!isOpen) arrow.style.color = 'rgb(var(--color-accent))';
                else arrow.style.color = '';
            };
        });

        listBtn.onclick = () => {
            listEl.classList.remove('hidden');
            graphEl.classList.add('hidden');
            listBtn.classList.add('text-accent', 'bg-accent/8');
            listBtn.classList.remove('text-muted');
            graphBtn.classList.add('text-muted');
            graphBtn.classList.remove('text-accent', 'bg-accent/8');
        };

        graphBtn.onclick = async () => {
            listEl.classList.add('hidden');
            graphEl.classList.remove('hidden');
            graphBtn.classList.add('text-accent', 'bg-accent/8');
            graphBtn.classList.remove('text-muted');
            listBtn.classList.add('text-muted');
            listBtn.classList.remove('text-accent', 'bg-accent/8');

            loadNotesGraph(graphEl);
        };
    }

    document.addEventListener('astro:page-load', initNotesPage);
    initNotesPage();
</script>
