---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');

const notes = allNotes.map(note => ({
    slug: note.slug,
    title: note.data.title,
    description: note.data.description,
    pubDate: note.data.pubDate.toISOString(),
    tags: note.data.tags || [],
    series: note.data.series,
    seriesOrder: note.data.seriesOrder,
}));

const seriesGroups: Record<string, typeof notes> = {};
const singles: typeof notes = [];
notes.forEach(note => {
    if (note.series) {
        if (!seriesGroups[note.series]) seriesGroups[note.series] = [];
        seriesGroups[note.series].push(note);
    } else {
        singles.push(note);
    }
});
Object.values(seriesGroups).forEach(g => g.sort((a, b) => (a.seriesOrder || 0) - (b.seriesOrder || 0)));
---

<BaseLayout title="Research Notes">
    <div class="max-w-4xl mx-auto px-6 py-16 min-h-screen">

        <header class="mb-14" data-animate="fade-up">
            <h1 class="text-4xl md:text-5xl font-display font-bold text-primary tracking-tight mb-4">
                Notes
            </h1>
            <p class="text-secondary font-body text-base max-w-xl leading-relaxed">
                Technical derivations and theoretical explorations in physics, mathematics, and computer science.
            </p>
        </header>

        <div class="w-full min-h-[400px]">
            <div id="notes-list" class="space-y-1" data-animate="stagger-fade-up">
                {Object.entries(seriesGroups).map(([seriesName, seriesNotes]) => (
                    <div class="rounded-lg overflow-hidden border border-edge" data-tilt="5">
                        <button
                            class="series-toggle w-full flex items-center gap-3 px-4 py-3.5 transition-colors text-left group hover:bg-primary/[0.02]"
                            data-series={seriesName}
                        >
                            <svg class="w-4 h-4 transition-transform text-muted series-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path d="m9 18 6-6-6-6" />
                            </svg>
                            <span class="font-display text-base font-semibold flex-1 text-secondary">
                                {seriesName}
                            </span>
                            <span class="font-mono text-[10px] px-2 py-0.5 rounded text-muted bg-primary/[0.04]">
                                {seriesNotes.length}
                            </span>
                        </button>
                        <div class="series-content hidden border-t border-edge">
                            {seriesNotes.map(note => (
                                <a
                                    href={`/notes/${note.slug}`}
                                    data-transition="enter"
                                    data-astro-prefetch="viewport"
                                    class="flex items-baseline gap-4 py-3 transition-colors rounded-md px-4 pl-12 hover:bg-accent/5"
                                >
                                    <span class="font-mono text-[11px] w-24 shrink-0 text-muted">
                                        {note.pubDate.split('T')[0]}
                                    </span>
                                    <span data-fly-title class="font-body text-[15px] text-primary/85">
                                        {note.title}
                                    </span>
                                    {note.seriesOrder != null && note.seriesOrder > 0 && (
                                        <span class="text-[10px] font-mono ml-auto text-muted">
                                            #{note.seriesOrder}
                                        </span>
                                    )}
                                </a>
                            ))}
                        </div>
                    </div>
                ))}
                {singles.map(note => (
                    <a
                        href={`/notes/${note.slug}`}
                        data-transition="enter"
                        data-astro-prefetch="viewport"
                        class="flex items-baseline gap-4 py-3 transition-colors rounded-md px-4 hover:bg-accent/5"
                    >
                        <span class="font-mono text-[11px] w-24 shrink-0 text-muted">
                            {note.pubDate.split('T')[0]}
                        </span>
                        <span data-fly-title class="font-body text-[15px] text-primary/85">
                            {note.title}
                        </span>
                    </a>
                ))}
            </div>

        </div>

    </div>
</BaseLayout>

<script>
    function initNotesPage() {
        document.querySelectorAll('.series-toggle').forEach(btn => {
            (btn as HTMLButtonElement).onclick = () => {
                const content = btn.nextElementSibling as HTMLElement;
                const arrow = btn.querySelector('.series-arrow') as SVGElement;
                const isOpen = !content.classList.contains('hidden');
                content.classList.toggle('hidden');
                arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(90deg)';
                (btn as HTMLElement).style.backgroundColor = isOpen ? '' : 'rgb(var(--color-accent) / 0.04)';
                btn.querySelector('.font-display')!.classList.toggle('text-primary', !isOpen);
                btn.querySelector('.font-display')!.classList.toggle('text-secondary', isOpen);
                if (!isOpen) arrow.style.color = 'rgb(var(--color-accent))';
                else arrow.style.color = '';
            };
        });
    }

    document.addEventListener('astro:page-load', initNotesPage);
    initNotesPage();
</script>
