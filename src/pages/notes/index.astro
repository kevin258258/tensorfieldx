---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { getCollection } from 'astro:content';
import { buildSeriesList, readMin } from '../../lib/series';

const allNotes = await getCollection('notes');
const seriesEntries = await getCollection('series');
const seriesList = buildSeriesList(seriesEntries, allNotes);

const singles = allNotes
    .filter((n) => !n.data.series)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((n) => ({
        slug: n.slug,
        title: n.data.title,
        pubDate: n.data.pubDate.toISOString().split('T')[0],
        min: readMin(n.body),
    }));

const ongoingCount = seriesList.filter((s) => s.status === 'ongoing').length;
const completeCount = seriesList.length - ongoingCount;
---

<BaseLayout title="Notes">
    <div class="relative max-w-6xl mx-auto px-6 py-14 md:py-20 min-h-screen" style="overflow-x: clip;">

        <div class="shelf-backdrop" aria-hidden="true">NOTES</div>

        <header class="relative flex flex-wrap items-end justify-between gap-4" data-animate="fade-up">
            <h1 class="font-display text-4xl md:text-6xl font-bold text-primary tracking-tight leading-[0.95]">
                Notes<span class="text-accent-warm">.</span>
            </h1>
            <div class="flex gap-2 font-sans text-xs" id="shelf-filters">
                <button data-filter="all" class="shelf-filter is-active">全部 {allNotes.length}</button>
                <button data-filter="ongoing" class="shelf-filter">连载中 {ongoingCount}</button>
                <button data-filter="complete" class="shelf-filter">已完结 {completeCount}</button>
            </div>
        </header>
        <p class="relative mt-3 font-mono text-[11px] tracking-[0.2em] text-accent-warm">
            STRUCTURED COURSE NOTES — READ IN ORDER ▸▸
        </p>

        <div class="shelf-grid relative mt-10" data-animate="fade-up">
            {seriesList.map((s, i) => (
                <SeriesCard series={s} index={i} lead={i === 0} />
            ))}
        </div>

        {singles.length > 0 && (
            <section class="relative mt-14">
                <h2 class="font-mono text-[10px] tracking-[0.2em] text-muted border-t-2 border-primary pt-4">
                    SINGLES — 单篇
                </h2>
                <div class="mt-3 divide-y divide-edge">
                    {singles.map((n) => (
                        <a
                            href={`/notes/${n.slug}`}
                            data-transition="enter"
                            data-astro-prefetch="viewport"
                            class="group flex items-baseline gap-4 py-3 px-2 rounded transition-colors hover:bg-accent/5"
                        >
                            <span class="font-mono text-[11px] w-24 shrink-0 text-muted">{n.pubDate}</span>
                            <span data-fly-title class="font-body text-[15px] text-primary/85 group-hover:text-accent transition-colors">
                                {n.title}
                            </span>
                            <span class="font-mono text-[10px] text-muted ml-auto shrink-0">{n.min} MIN</span>
                        </a>
                    ))}
                </div>
            </section>
        )}

    </div>
</BaseLayout>

<script>
    function initNotesPage() {
        const buttons = document.querySelectorAll<HTMLButtonElement>('#shelf-filters .shelf-filter');
        const cards = document.querySelectorAll<HTMLElement>('.shelf-card');
        if (!buttons.length) return;

        buttons.forEach((btn) => {
            btn.onclick = () => {
                buttons.forEach((b) => b.classList.remove('is-active'));
                btn.classList.add('is-active');
                const filter = btn.dataset.filter;
                cards.forEach((card) => {
                    card.style.display = filter === 'all' || card.dataset.status === filter ? '' : 'none';
                });
            };
        });
    }

    document.addEventListener('astro:page-load', initNotesPage);
    initNotesPage();
</script>
