---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { getCollection } from 'astro:content';
import { buildSeriesList, readMin } from '../../lib/series';

const allNotes = await getCollection('notes');
const seriesEntries = await getCollection('series');
const seriesList = buildSeriesList(seriesEntries, allNotes);

const singles = allNotes
    .filter((n) => !n.data.series)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((n) => ({
        slug: n.slug,
        title: n.data.title,
        pubDate: n.data.pubDate.toISOString().split('T')[0],
        min: readMin(n.body),
    }));

const ongoingCount = seriesList.filter((s) => s.status === 'ongoing').length;
const completeCount = seriesList.length - ongoingCount;
---

<BaseLayout title="Notes">
    <div class="max-w-4xl mx-auto px-6 py-16 min-h-screen">

        <header class="mb-10" data-animate="fade-up">
            <h1 class="text-4xl md:text-5xl font-display font-bold text-primary tracking-tight mb-4">
                Notes
            </h1>
            <p class="text-secondary font-body text-base max-w-xl leading-relaxed">
                Technical derivations and structured course notes in physics, mathematics, and computer science.
            </p>
        </header>

        <div class="flex justify-end mb-6 border-b border-edge pb-3">
            <div class="flex flex-wrap gap-1 font-sans text-xs" id="shelf-filters">
                <button data-filter="all" class="shelf-filter is-active">All {allNotes.length}</button>
                <button data-filter="ongoing" class="shelf-filter">Ongoing {ongoingCount}</button>
                <button data-filter="complete" class="shelf-filter">Complete {completeCount}</button>
            </div>
        </div>

        <div class="shelf-grid" data-animate="stagger-fade-up">
            {seriesList.map((s, i) => (
                <SeriesCard series={s} index={i} />
            ))}
        </div>

        {singles.length > 0 && (
            <section class="mt-14">
                <h2 class="font-mono text-[10px] uppercase tracking-widest text-muted border-b border-edge pb-3">
                    Single Notes
                </h2>
                <div class="mt-3 divide-y divide-edge">
                    {singles.map((n) => (
                        <a
                            href={`/notes/${n.slug}`}
                            data-transition="enter"
                            data-astro-prefetch="viewport"
                            class="group flex items-baseline gap-4 py-3 px-2 rounded transition-colors hover:bg-accent/5"
                        >
                            <span class="font-mono text-[11px] w-24 shrink-0 text-muted">{n.pubDate}</span>
                            <span data-fly-title class="font-body text-[15px] text-primary/85 group-hover:text-accent transition-colors">
                                {n.title}
                            </span>
                            <span class="font-mono text-[10px] text-muted ml-auto shrink-0">{n.min} MIN</span>
                        </a>
                    ))}
                </div>
            </section>
        )}

    </div>
</BaseLayout>

<script>
    function initNotesPage() {
        const buttons = document.querySelectorAll<HTMLButtonElement>('#shelf-filters .shelf-filter');
        const cards = document.querySelectorAll<HTMLElement>('.shelf-card');
        if (!buttons.length) return;

        buttons.forEach((btn) => {
            btn.onclick = () => {
                buttons.forEach((b) => b.classList.remove('is-active'));
                btn.classList.add('is-active');
                const filter = btn.dataset.filter;
                cards.forEach((card) => {
                    card.style.display = filter === 'all' || card.dataset.status === filter ? '' : 'none';
                });
            };
        });
    }

    document.addEventListener('astro:page-load', initNotesPage);
    initNotesPage();
</script>
