---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidenote from '../../components/Sidenote.astro';
import Giscus from '../../components/Giscus.astro';

export async function getStaticPaths() {
    const posts = await getCollection('notes');
    const sorted = posts.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
    return sorted.map((post, i) => ({
        params: { slug: post.slug },
        props: {
            post,
            prev: i > 0 ? { slug: sorted[i - 1].slug, title: sorted[i - 1].data.title } : null,
            next: i < sorted.length - 1 ? { slug: sorted[i + 1].slug, title: sorted[i + 1].data.title } : null,
            seriesPosts: post.data.series
                ? sorted
                    .filter(p => p.data.series === post.data.series)
                    .sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0))
                    .map(p => ({ slug: p.slug, title: p.data.title, order: p.data.seriesOrder }))
                : [],
        },
    }));
}

const { post, prev, next, seriesPosts } = Astro.props;
const { Content, headings } = await post.render();

const readTime = Math.max(1, Math.round((post.body?.length || 0) / 1000));
const currentSeriesIdx = seriesPosts.findIndex((p: any) => p.slug === post.slug);
---

<BaseLayout title={post.data.title}>

    <div class="fixed top-0 left-0 w-full h-[2px] z-50 pointer-events-none">
        <div class="h-full bg-accent/60 w-[0%] transition-[width] duration-100" id="progress-bar"></div>
    </div>

    <article class="max-w-[90rem] mx-auto mt-8 lg:mt-16 grid grid-cols-1 lg:grid-cols-[220px_1fr_220px] gap-8 px-4 lg:px-8 pb-24">

        <aside class="hidden lg:block h-full relative">
            <div class="sticky top-24 py-2" id="toc-sidebar">

                <a href="/notes" class="flex items-center gap-1.5 text-[11px] font-sans text-muted mb-8 hover:text-accent transition-colors">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 12H5m0 0 7 7m-7-7 7-7"/></svg>
                    Back
                </a>

                <h3 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-4">
                    Contents
                </h3>
                <ul class="space-y-2 font-sans text-xs" id="toc-list">
                    {headings.map((heading) => (
                        <li
                            class:list={[
                                "toc-item transition-colors duration-200 leading-snug",
                                heading.depth === 2 ? 'font-medium text-secondary' : 'pl-3 text-muted',
                            ]}
                            data-depth={heading.depth}
                        >
                            <a href={`#${heading.slug}`} class="block truncate toc-link" data-slug={heading.slug}>
                                {heading.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </aside>

        <div class="min-w-0 relative">

            <nav class="flex items-center gap-1.5 font-sans text-[11px] text-muted mb-6" aria-label="Breadcrumb">
                <a href="/" class="hover:text-accent transition-colors">Home</a>
                <span>/</span>
                <a href="/notes" class="hover:text-accent transition-colors">Notes</a>
                {post.data.series && (
                    <Fragment>
                        <span>/</span>
                        <span class="text-secondary">{post.data.series}</span>
                    </Fragment>
                )}
                <span>/</span>
                <span class="text-primary truncate max-w-[200px]">{post.data.title}</span>
            </nav>

            <header class="mb-10">
                <div class="flex flex-wrap items-center gap-3 font-mono text-[11px] text-muted mb-5">
                    {post.data.series && (
                        <span class="text-accent bg-accent/8 px-2 py-0.5 rounded font-sans font-medium text-[11px]">
                            {post.data.series}
                        </span>
                    )}
                    <span>{post.data.pubDate.toLocaleDateString('en-CA')}</span>
                    <span>·</span>
                    <span>{readTime} min read</span>
                </div>

                <h1 class="text-3xl md:text-5xl lg:text-[3.25rem] font-display font-bold mb-6 leading-[1.15] text-primary tracking-tight">
                    {post.data.title}
                </h1>

                {post.data.tags && (
                    <div class="flex flex-wrap gap-2">
                        {post.data.tags.map((tag: string) => (
                            <a href={`/tags/${tag}`} class="text-xs font-sans text-muted border border-edge px-2.5 py-1.5 md:px-2 md:py-0.5 rounded hover:text-accent hover:border-accent/30 transition-colors">
                                {tag}
                            </a>
                        ))}
                    </div>
                )}
            </header>

            <div class="prose prose-lg max-w-none
                prose-headings:font-display prose-headings:font-bold prose-headings:text-primary prose-headings:scroll-mt-24
                prose-p:font-body prose-p:text-primary/85 prose-p:leading-[1.85]
                prose-strong:text-primary prose-strong:font-bold
                prose-a:text-accent prose-a:no-underline prose-a:border-b prose-a:border-accent/30 hover:prose-a:border-accent prose-a:transition-colors
                prose-li:text-primary/80 prose-li:marker:text-accent
                prose-blockquote:border-accent/30 prose-blockquote:text-secondary prose-blockquote:font-body prose-blockquote:not-italic
                prose-code:font-mono prose-code:text-sm prose-code:bg-surface prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:border prose-code:border-edge prose-code:before:content-none prose-code:after:content-none
                prose-pre:bg-surface prose-pre:border prose-pre:border-edge prose-pre:rounded-lg
                prose-img:rounded prose-img:border prose-img:border-edge
                prose-hr:border-edge
                overflow-visible relative">

                <Content components={{ Sidenote }} />

            </div>

            <div class="mt-20 flex items-center justify-center gap-4 text-muted">
                <div class="h-px w-16 bg-edge"></div>
                <span class="font-mono text-[10px] tracking-widest">END</span>
                <div class="h-px w-16 bg-edge"></div>
            </div>

            {seriesPosts.length > 1 && (
                <div class="mt-12 p-5 border border-edge rounded-lg bg-surface/50">
                    <h4 class="font-sans text-xs font-medium text-muted uppercase tracking-wider mb-3">
                        Series: {post.data.series}
                    </h4>
                    <ol class="space-y-1.5">
                        {seriesPosts.map((sp: any, i: number) => (
                            <li class:list={["text-sm font-body", i === currentSeriesIdx ? "text-accent font-medium" : "text-secondary"]}>
                                <span class="font-mono text-[10px] text-muted mr-2">{i + 1}.</span>
                                {i === currentSeriesIdx ? (
                                    <span>{sp.title}</span>
                                ) : (
                                    <a href={`/notes/${sp.slug}`} class="hover:text-accent transition-colors">{sp.title}</a>
                                )}
                            </li>
                        ))}
                    </ol>
                </div>
            )}

            <nav class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
                {prev ? (
                    <a href={`/notes/${prev.slug}`} class="group flex flex-col p-4 border border-edge rounded-lg hover:border-accent/30 hover:bg-accent/3 transition-all">
                        <span class="font-mono text-[10px] text-muted mb-1">&larr; Previous</span>
                        <span class="font-body text-sm text-primary group-hover:text-accent transition-colors line-clamp-1">{prev.title}</span>
                    </a>
                ) : <div />}
                {next ? (
                    <a href={`/notes/${next.slug}`} class="group flex flex-col items-end text-right p-4 border border-edge rounded-lg hover:border-accent/30 hover:bg-accent/3 transition-all">
                        <span class="font-mono text-[10px] text-muted mb-1">Next &rarr;</span>
                        <span class="font-body text-sm text-primary group-hover:text-accent transition-colors line-clamp-1">{next.title}</span>
                    </a>
                ) : <div />}
            </nav>

            <Giscus />

        </div>

        <div class="hidden lg:block"></div>

    </article>

    <!-- Mobile floating TOC -->
    {headings.length > 0 && (
        <div class="lg:hidden fixed bottom-6 right-6 z-40">
            <button
                id="mobile-toc-toggle"
                class="p-3.5 rounded-full bg-surface border border-edge shadow-lg text-muted hover:text-accent transition-colors min-w-[48px] min-h-[48px] flex items-center justify-center"
                aria-label="Table of contents"
            >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
                </svg>
            </button>
            <div id="mobile-toc-panel" class="hidden absolute bottom-14 right-0 w-64 max-h-80 overflow-y-auto bg-paper border border-edge rounded-lg shadow-xl p-4">
                <h3 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-3">Contents</h3>
                <ul class="space-y-2">
                    {headings.map((heading) => (
                        <li class:list={[heading.depth === 2 ? '' : 'pl-3']}>
                            <a
                                href={`#${heading.slug}`}
                                class="mobile-toc-link block text-xs font-sans text-secondary hover:text-accent transition-colors truncate"
                                data-slug={heading.slug}
                            >
                                {heading.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    )}
</BaseLayout>

<script>
    function initProgress() {
        const bar = document.getElementById("progress-bar");
        if (!bar) return;

        function update() {
            const scrollTop = window.scrollY || document.documentElement.scrollTop;
            const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
            if (scrollHeight > 0) {
                bar!.style.width = Math.min(100, (scrollTop / scrollHeight) * 100) + "%";
            }
        }

        window.addEventListener('scroll', update, { passive: true });
        update();
    }

    function initTocTracking() {
        const tocLinks = document.querySelectorAll('.toc-link');
        const tocItems = document.querySelectorAll('.toc-item');
        if (!tocLinks.length) return;

        const slugs = Array.from(tocLinks).map(l => (l as HTMLElement).dataset.slug!);
        const headingEls = slugs.map(s => document.getElementById(s)).filter(Boolean) as HTMLElement[];
        if (!headingEls.length) return;

        function updateActive() {
            const scrollY = window.scrollY + 120;
            let activeIdx = 0;

            for (let i = headingEls.length - 1; i >= 0; i--) {
                if (headingEls[i].offsetTop <= scrollY) {
                    activeIdx = i;
                    break;
                }
            }

            tocItems.forEach((item, i) => {
                const link = item.querySelector('.toc-link') as HTMLElement;
                const depth = item.getAttribute('data-depth');
                if (i === activeIdx) {
                    link.style.color = 'rgb(var(--color-accent))';
                    item.classList.add('font-semibold');
                } else {
                    link.style.color = '';
                    item.classList.remove('font-semibold');
                }
            });
        }

        window.addEventListener('scroll', updateActive, { passive: true });
        updateActive();
    }

    function initMobileToc() {
        const toggle = document.getElementById('mobile-toc-toggle');
        const panel = document.getElementById('mobile-toc-panel');
        if (!toggle || !panel) return;

        toggle.onclick = (e) => {
            e.stopPropagation();
            panel.classList.toggle('hidden');
        };
        document.addEventListener('click', (e) => {
            if (!panel.contains(e.target as Node) && e.target !== toggle) {
                panel.classList.add('hidden');
            }
        });
        panel.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => panel.classList.add('hidden'));
        });
    }

    document.addEventListener('astro:page-load', () => {
        initProgress();
        initTocTracking();
        initMobileToc();
    });
</script>
