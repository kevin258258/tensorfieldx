---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
    { label: "GitHub", value: "@kevin258258", url: "https://github.com/kevin258258" },
    { label: "X", value: "@Feixiang_Tao", url: "https://x.com/Feixiang_Tao" },
    { label: "Zhihu", value: "Three-23-89", url: "https://www.zhihu.com/people/three-23-89" },
    { label: "Email", value: "12512619@mail.sustech.edu.cn", url: "mailto:12512619@mail.sustech.edu.cn" }
];

const interests = [
    "Differential Geometry",
    "Statistical Mechanics",
    "Deep Learning",
    "Matrix Calculus",
    "System Architecture",
];
---

<BaseLayout title="About">

    <!-- Hero banner with photo -->
    <div class="relative h-48 md:h-72 overflow-hidden" data-animate="fade-in">
        <img
            src="/images/IMG_0511.webp"
            alt=""
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
            decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-paper via-paper/40 to-transparent"></div>
        <div class="absolute inset-0 flex items-end">
            <div class="max-w-4xl mx-auto px-6 pb-8 w-full">
                <h1 class="font-display text-4xl md:text-5xl font-bold text-primary tracking-tight">About</h1>
            </div>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-6 py-16">
        <div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-16 items-start">

            <aside data-animate="slide-right">
                <div class="w-20 h-20 bg-accent text-white flex items-center justify-center text-4xl font-display italic font-bold rounded-xl mb-6">
                    T
                </div>

                <h2 class="font-display text-2xl font-bold text-primary mb-1">Feixiang Tao</h2>
                <p class="font-sans text-sm text-accent font-medium mb-6">Freshman @ SUSTech</p>

                <div class="space-y-3 font-sans text-sm border-t border-edge pt-6">
                    <div class="flex justify-between">
                        <span class="text-muted">Major</span>
                        <span class="text-secondary">TBD</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted">Focus</span>
                        <span class="text-secondary">Physics / Math / AI</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted">Location</span>
                        <span class="text-secondary">Shenzhen, CN</span>
                    </div>
                </div>
            </aside>

            <main data-animate="slide-left">
                <div class="mb-12">
                    <p class="font-body text-xl text-primary leading-relaxed mb-6">
                        Hi, I'm Feixiang. A freshman undergraduate student at
                        <span class="text-accent font-medium">SUSTech</span>.
                    </p>

                    <div class="font-body text-base text-secondary leading-[1.85] space-y-4">
                        <p>
                            I am currently building my foundational knowledge in Computer Science,
                            Physics and Mathematics.
                        </p>
                        <p>
                            This website serves as a personal archive for my undergraduate studies.
                            I use it to document course notes, lab experiments, and my understanding
                            of fundamental theories.
                        </p>
                        <p class="text-primary font-medium">
                            Always learning, always exploring.
                        </p>
                    </div>
                </div>

                <div class="mb-12" data-animate="stagger-fade-up">
                    <h3 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-4">Interests</h3>
                    <div class="flex flex-wrap gap-2">
                        {interests.map(interest => (
                            <span class="font-sans text-xs text-secondary border border-edge px-3 py-1.5 rounded-md">
                                {interest}
                            </span>
                        ))}
                    </div>
                </div>

                <div>
                    <h3 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-4">Connect</h3>
                    <div data-animate="stagger-fade-up">
                        {contacts.map(contact => (
                            <a href={contact.url} target="_blank" class="flex items-center justify-between group py-2.5 px-3 hover:bg-accent/5 transition-colors rounded-md" data-tilt="4">
                                <span class="font-body text-base text-primary group-hover:text-accent transition-colors">
                                    {contact.label}
                                </span>
                                <span class="font-mono text-xs text-muted group-hover:text-secondary transition-colors">
                                    {contact.value}
                                    <svg class="inline w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7m0 0H7m10 0v10"/></svg>
                                </span>
                            </a>
                        ))}
                    </div>
                </div>
            </main>
        </div>
    </div>
</BaseLayout>
