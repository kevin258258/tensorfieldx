---
import BaseLayout from '../layouts/BaseLayout.astro';

const education = [
    {
        institution: "Southern University of Science and Technology (SUSTech)",
        degree: "Undergraduate",
        period: "2025 – Present",
        details: "Focus: Physics, Mathematics, Computer Science"
    }
];

const skills = {
    "Languages": ["Python", "C/C++", "JavaScript/TypeScript", "LaTeX"],
    "Frameworks": ["React", "Astro", "PyTorch"],
    "Topics": ["Differential Geometry", "Statistical Mechanics", "Deep Learning", "Matrix Calculus"],
};
---

<BaseLayout title="CV">
    <div class="max-w-3xl mx-auto px-6 py-16 min-h-screen">

        <header class="mb-14">
            <h1 class="text-4xl md:text-5xl font-display font-bold text-primary tracking-tight mb-2">
                Curriculum Vitae
            </h1>
            <p class="font-sans text-sm text-muted">Last updated: March 2026</p>
        </header>

        <div class="space-y-12">

            <!-- Name -->
            <section>
                <h2 class="font-display text-2xl font-bold text-primary mb-1">Feixiang Tao</h2>
                <p class="font-sans text-sm text-secondary">
                    Undergraduate Student · SUSTech · Shenzhen, China
                </p>
                <p class="font-mono text-xs text-muted mt-2">
                    12512619@mail.sustech.edu.cn ·
                    <a href="https://github.com/kevin258258" class="text-accent hover:underline" target="_blank">GitHub</a> ·
                    <a href="https://tensorfieldx.space" class="text-accent hover:underline">Website</a>
                </p>
            </section>

            <!-- Education -->
            <section>
                <h2 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-4 pb-2 border-b border-edge">Education</h2>
                {education.map(edu => (
                    <div class="mb-4">
                        <div class="flex justify-between items-baseline">
                            <h3 class="font-body text-base font-semibold text-primary">{edu.institution}</h3>
                            <span class="font-mono text-[11px] text-muted shrink-0 ml-4">{edu.period}</span>
                        </div>
                        <p class="font-sans text-sm text-secondary mt-0.5">{edu.degree}</p>
                        {edu.details && <p class="font-sans text-xs text-muted mt-1">{edu.details}</p>}
                    </div>
                ))}
            </section>

            <!-- Skills -->
            <section>
                <h2 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-4 pb-2 border-b border-edge">Skills & Interests</h2>
                <div class="space-y-4">
                    {Object.entries(skills).map(([category, items]) => (
                        <div>
                            <h3 class="font-sans text-xs font-medium text-secondary mb-2">{category}</h3>
                            <div class="flex flex-wrap gap-1.5">
                                {items.map(item => (
                                    <span class="font-mono text-[11px] text-primary/80 border border-edge px-2 py-1 rounded">
                                        {item}
                                    </span>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- Publications placeholder -->
            <section>
                <h2 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-4 pb-2 border-b border-edge">Publications</h2>
                <p class="font-body text-sm text-muted italic">Coming soon.</p>
            </section>

        </div>

    </div>
</BaseLayout>
