---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
let allBlog: any[] = [];
try { allBlog = await getCollection('blog'); } catch (e) {}

const allContent = [...allNotes, ...allBlog];
const tagMap = new Map<string, number>();

allContent.forEach(item => {
    item.data.tags?.forEach((tag: string) => {
        tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
    });
});

const tags = Array.from(tagMap.entries())
    .sort((a, b) => b[1] - a[1]);

const maxCount = Math.max(...tags.map(t => t[1]), 1);
---

<BaseLayout title="Tags">
    <div class="max-w-3xl mx-auto px-6 py-16 min-h-screen">

        <header class="mb-14" data-animate="fade-up">
            <h1 class="text-4xl md:text-5xl font-display font-bold text-primary tracking-tight mb-4">
                Tags
            </h1>
            <p class="text-secondary font-body text-base max-w-xl leading-relaxed">
                {tags.length} tags across {allContent.length} posts
            </p>
        </header>

        <div class="flex flex-wrap gap-3">
            {tags.map(([tag, count]) => {
                const scale = 0.875 + (count / maxCount) * 0.375;
                return (
                    <a
                        href={`/tags/${tag}`}
                        class="group inline-flex items-center gap-1.5 px-3 py-2.5 md:py-1.5 border border-edge rounded-md hover:border-accent/40 hover:bg-accent/5 transition-all min-h-[44px] md:min-h-0"
                        style={`font-size: ${scale}rem;`}
                    >
                        <span class="text-accent opacity-60 group-hover:opacity-100 transition-opacity">#</span>
                        <span class="font-sans text-primary group-hover:text-accent transition-colors">{tag}</span>
                        <span class="font-mono text-[10px] text-muted ml-0.5">{count}</span>
                    </a>
                );
            })}
        </div>

        {tags.length === 0 && (
            <div class="text-center py-20">
                <p class="font-body text-secondary text-lg mb-2">No tags yet.</p>
                <p class="font-sans text-sm text-muted">Tags will appear as content is published.</p>
            </div>
        )}

    </div>
</BaseLayout>
