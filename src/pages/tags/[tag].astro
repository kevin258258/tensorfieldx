---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
    const allNotes = await getCollection('notes');
    let allBlog: any[] = [];
    try { allBlog = await getCollection('blog'); } catch (e) {}

    const allContent = [...allNotes, ...allBlog];
    const tagSet = new Set<string>();

    allContent.forEach(item => {
        item.data.tags?.forEach((tag: string) => tagSet.add(tag));
    });

    return Array.from(tagSet).map(tag => ({
        params: { tag },
        props: {
            tag,
            items: allContent
                .filter(item => item.data.tags?.includes(tag))
                .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
        },
    }));
}

const { tag, items } = Astro.props;

function getItemUrl(item: any) {
    if (item.collection === 'blog') return `/blog/${item.slug}`;
    return `/notes/${item.slug}`;
}
---

<BaseLayout title={`#${tag}`}>
    <div class="max-w-3xl mx-auto px-6 py-16 min-h-screen">

        <header class="mb-14" data-animate="fade-up">
            <a href="/tags" class="inline-flex items-center gap-1.5 text-sm font-sans text-muted hover:text-accent transition-colors mb-6">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 12H5m0 0 7 7m-7-7 7-7"/></svg>
                Back
            </a>
            <h1 class="text-4xl md:text-5xl font-display font-bold text-primary tracking-tight">
                <span class="text-accent">#</span>{tag}
            </h1>
            <p class="font-sans text-sm text-muted mt-2">{items.length} item{items.length !== 1 ? 's' : ''}</p>
        </header>

        <div class="divide-y divide-edge" data-animate="stagger-fade-up">
            {items.map((item: any) => (
                <a href={getItemUrl(item)} class="group flex items-baseline gap-4 py-4 hover:bg-accent/3 px-3 rounded transition-colors">
                    <span class="font-mono text-[11px] text-muted w-24 shrink-0">
                        {item.data.pubDate.toISOString().split('T')[0]}
                    </span>
                    <span class="font-body text-base text-primary group-hover:text-accent transition-colors flex-1">
                        {item.data.title}
                    </span>
                    <span class="hidden md:inline font-mono text-[10px] text-muted capitalize">
                        {item.collection}
                    </span>
                </a>
            ))}
        </div>

    </div>
</BaseLayout>
