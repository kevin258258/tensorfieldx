---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveView from '../../components/ArchiveView.astro';
import { getArchiveEntries } from '../../lib/archive';
const entries = (await getArchiveEntries()).filter(entry => entry.category === 'Projects');
---
<BaseLayout title="Projects"><ArchiveView entries={entries} title="Projects" description="Open-source tools, system architectures, and experimental labs." /></BaseLayout>
