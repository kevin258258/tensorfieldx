---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
const sortedNotes = allNotes.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Home">

	<!-- Hero: Full-bleed artwork with dramatic color -->
	<section class="relative min-h-[85vh] flex flex-col justify-end overflow-hidden" id="hero-section">

		<div class="absolute inset-0 z-0">
			<img
				src="/images/hero.png"
				alt=""
				class="absolute inset-0 w-full h-full object-cover"
				loading="eager"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
		</div>

		<div class="relative z-10 px-6 pb-16 md:pb-24 max-w-6xl mx-auto w-full">
			<h1 class="font-display text-6xl md:text-8xl lg:text-9xl font-bold leading-[0.9] tracking-tighter text-white">
				Tensor<span class="italic font-normal opacity-80">Field</span>X
			</h1>

			<p class="mt-6 font-sans text-sm md:text-base text-white/70 max-w-md leading-relaxed">
				A personal archive of physics, mathematics, and computer science.
			</p>
		</div>

		<!-- Gradient fade to paper -->
		<div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-paper to-transparent z-10"></div>

		<!-- Scroll hint -->
		<div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 animate-bounce">
			<svg class="w-5 h-5 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
			</svg>
		</div>
	</section>

	<!-- Identity -->
	<section class="relative z-20">
		<div class="max-w-4xl mx-auto px-6 py-20 grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 items-start">

			<div>
				<div class="w-16 h-16 bg-accent text-white flex items-center justify-center text-3xl font-display italic font-bold rounded-lg mb-5">
					T
				</div>
				<h2 class="font-display text-2xl font-bold text-primary">Feixiang Tao</h2>
				<p class="font-sans text-sm text-accent mt-1 font-medium">Freshman @ SUSTech</p>

				<div class="mt-6 space-y-2 font-sans text-xs text-muted">
					<div class="flex justify-between">
						<span>Focus</span>
						<span class="text-secondary">Physics / Math / AI</span>
					</div>
					<div class="flex justify-between">
						<span>Location</span>
						<span class="text-secondary">Shenzhen, CN</span>
					</div>
				</div>
			</div>

			<div>
				<p class="font-body text-xl md:text-2xl text-primary leading-relaxed mb-6">
					Documenting my undergraduate journey at <span class="text-accent">SUSTech</span> &mdash;
					course notes, technical explorations, and project blueprints.
				</p>
				<p class="font-body text-base text-secondary leading-relaxed">
					Welcome to my personal archive. Here I record my learning process across disciplines,
					from differential geometry to deep learning architectures. Simple, open, and always learning.
				</p>
			</div>
		</div>
	</section>

	<!-- Navigation Cards -->
	<section class="border-t border-edge">
		<div class="max-w-4xl mx-auto px-6 py-16">
			<h2 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-8">Explore</h2>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<a href="/notes" class="group p-6 border border-edge rounded-lg hover:border-accent/30 hover:bg-accent/3 transition-all">
					<h3 class="font-display text-xl font-bold text-primary group-hover:text-accent transition-colors mb-2">Notes</h3>
					<p class="font-sans text-xs text-muted leading-relaxed">Course notes and technical derivations.</p>
				</a>
				<a href="/projects" class="group p-6 border border-edge rounded-lg hover:border-accent/30 hover:bg-accent/3 transition-all">
					<h3 class="font-display text-xl font-bold text-primary group-hover:text-accent transition-colors mb-2">Projects</h3>
					<p class="font-sans text-xs text-muted leading-relaxed">Experiments and coursework.</p>
				</a>
				<a href="/about" class="group p-6 border border-edge rounded-lg hover:border-accent/30 hover:bg-accent/3 transition-all">
					<h3 class="font-display text-xl font-bold text-primary group-hover:text-accent transition-colors mb-2">About</h3>
					<p class="font-sans text-xs text-muted leading-relaxed">Profile and contact.</p>
				</a>
			</div>
		</div>
	</section>

	<!-- Recent Notes -->
	<section class="border-t border-edge">
		<div class="max-w-4xl mx-auto px-6 py-16">
			<h2 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-8">Recent</h2>

			<div class="divide-y divide-edge">
				{sortedNotes.slice(0, 6).map((note) => (
					<a href={`/notes/${note.slug}`} class="group flex items-baseline gap-4 py-4 hover:bg-accent/3 -mx-3 px-3 rounded transition-colors">
						<span class="font-mono text-[11px] text-muted w-24 shrink-0">
							{note.data.pubDate.toISOString().split('T')[0]}
						</span>
						<span class="font-body text-base text-primary group-hover:text-accent transition-colors flex-1">
							{note.data.title}
						</span>
						{note.data.series && (
							<span class="hidden md:inline font-sans text-[10px] text-muted">
								{note.data.series}
							</span>
						)}
					</a>
				))}
			</div>

			<div class="mt-8">
				<a href="/notes" class="inline-flex items-center gap-2 font-sans text-sm text-accent hover:underline underline-offset-4">
					View all notes
					<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14m0 0-7-7m7 7-7 7"/></svg>
				</a>
			</div>
		</div>
	</section>

</BaseLayout>
