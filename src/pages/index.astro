---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
const sortedNotes = allNotes.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Home">

	<!-- Hero: Full-bleed artwork with dramatic color -->
	<section class="relative min-h-[85vh] flex flex-col justify-end overflow-hidden" id="hero-section">

		<div class="absolute inset-0 z-0">
			<img
				src="/images/hero.webp"
				alt=""
				class="absolute inset-0 w-full h-full object-cover"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
		</div>

		<canvas class="hero-particles-canvas" id="hero-particles" aria-hidden="true"></canvas>

		<div class="relative z-10 px-6 pb-16 md:pb-24 max-w-6xl mx-auto w-full">
			<h1 class="font-display text-5xl md:text-8xl lg:text-9xl font-bold leading-[0.9] tracking-tighter text-white">
				Tensor<span class="italic font-normal opacity-80">Field</span>X
			</h1>

			<p class="mt-6 font-sans text-sm md:text-base text-white/70 max-w-md leading-relaxed">
				A personal archive of physics, mathematics, and computer science.
			</p>
		</div>

		<!-- Gradient fade to paper -->
		<div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-paper to-transparent z-10"></div>

	</section>

	<!-- Identity -->
	<section class="relative z-20" data-animate="fade-up">
		<div class="max-w-4xl mx-auto px-6 py-20 grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 items-start">

			<div>
				<div class="w-16 h-16 bg-accent text-white flex items-center justify-center text-3xl font-display italic font-bold rounded-lg mb-5">
					T
				</div>
				<h2 class="font-display text-2xl font-bold text-primary">Feixiang Tao</h2>
				<p class="font-sans text-sm text-accent mt-1 font-medium">Freshman @ SUSTech</p>

				<div class="mt-6 space-y-2 font-sans text-xs text-muted">
					<div class="flex justify-between">
						<span>Focus</span>
						<span class="text-secondary">Physics / Math / AI</span>
					</div>
					<div class="flex justify-between">
						<span>Location</span>
						<span class="text-secondary">Shenzhen, CN</span>
					</div>
				</div>
			</div>

			<div>
				<p class="font-body text-xl md:text-2xl text-primary leading-relaxed mb-6">
					Documenting my undergraduate journey at <span class="text-accent">SUSTech</span> &mdash;
					course notes, technical explorations, and project blueprints.
				</p>
				<p class="font-body text-base text-secondary leading-relaxed">
					Welcome to my personal archive. Here I record my learning process across disciplines,
					from differential geometry to deep learning architectures. Simple, open, and always learning.
				</p>
			</div>
		</div>
	</section>

	<!-- Navigation Cards -->
	<section class="border-t border-edge" data-animate="fade-up">
		<div class="max-w-4xl mx-auto px-6 py-16">
			<h2 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-8">Explore</h2>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<a href="/notes" class="group p-6 border border-edge rounded-lg hover:border-accent/30 hover:bg-accent/3 transition-all" data-tilt="6">
					<h3 class="font-display text-xl font-bold text-primary group-hover:text-accent transition-colors mb-2">Notes</h3>
					<p class="font-sans text-xs text-muted leading-relaxed">Course notes and technical derivations.</p>
				</a>
				<a href="/projects" class="group p-6 border border-edge rounded-lg hover:border-accent/30 hover:bg-accent/3 transition-all" data-tilt="6">
					<h3 class="font-display text-xl font-bold text-primary group-hover:text-accent transition-colors mb-2">Projects</h3>
					<p class="font-sans text-xs text-muted leading-relaxed">Experiments and coursework.</p>
				</a>
				<a href="/about" class="group p-6 border border-edge rounded-lg hover:border-accent/30 hover:bg-accent/3 transition-all" data-tilt="6">
					<h3 class="font-display text-xl font-bold text-primary group-hover:text-accent transition-colors mb-2">About</h3>
					<p class="font-sans text-xs text-muted leading-relaxed">Profile and contact.</p>
				</a>
			</div>
		</div>
	</section>

	<!-- Recent Notes -->
	<section class="border-t border-edge" data-animate="stagger-fade-up">
		<div class="max-w-4xl mx-auto px-6 py-16">
			<h2 class="font-mono text-[10px] text-muted uppercase tracking-widest mb-8">Recent</h2>

			<div class="divide-y divide-edge">
				{sortedNotes.slice(0, 6).map((note) => (
					<a href={`/notes/${note.slug}`} class="group flex items-baseline gap-4 py-4 hover:bg-accent/3 px-3 rounded transition-colors">
						<span class="font-mono text-[11px] text-muted w-24 shrink-0">
							{note.data.pubDate.toISOString().split('T')[0]}
						</span>
						<span class="font-body text-base text-primary group-hover:text-accent transition-colors flex-1">
							{note.data.title}
						</span>
						{note.data.series && (
							<span class="hidden md:inline font-sans text-[10px] text-muted">
								{note.data.series}
							</span>
						)}
					</a>
				))}
			</div>

			<div class="mt-8">
				<a href="/notes" class="inline-flex items-center gap-2 font-sans text-sm text-accent hover:underline underline-offset-4">
					View all notes
					<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14m0 0-7-7m7 7-7 7"/></svg>
				</a>
			</div>
		</div>
	</section>

</BaseLayout>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const isMobile = window.matchMedia('(max-width: 767px)').matches;

	const canvas = document.getElementById('hero-particles');
	if (canvas) {
		const ctx = canvas.getContext('2d');
		if (!ctx) throw new Error('Canvas 2D not supported');

		const hero = document.getElementById('hero-section');
		let w, h;

		function resize() {
			if (!hero) return;
			const rect = hero.getBoundingClientRect();
			w = canvas.width = rect.width * (window.devicePixelRatio || 1);
			h = canvas.height = rect.height * (window.devicePixelRatio || 1);
			ctx.setTransform((window.devicePixelRatio || 1), 0, 0, (window.devicePixelRatio || 1), 0, 0);
			canvas.style.width = rect.width + 'px';
			canvas.style.height = rect.height + 'px';
		}

		const particleCount = isMobile ? 25 : prefersReducedMotion ? 0 : 55;
		const particles = [];
		const connectionDist = isMobile ? 80 : 130;

		for (let i = 0; i < particleCount; i++) {
			particles.push({
				x: Math.random() * (w || 1200),
				y: Math.random() * (h || 800),
				vx: (Math.random() - 0.5) * 0.3,
				vy: -(Math.random() * 0.4 + 0.15),
				size: Math.random() * 2.5 + 1.5,
				shape: Math.random() > 0.7 ? 'diamond' : 'circle',
				opacity: Math.random() * 0.4 + 0.15,
			});
		}

		let mouseX = -200, mouseY = -200;
		let targetMouseX = -200, targetMouseY = -200;

		document.addEventListener('mousemove', (e) => {
			if (!hero) return;
			const rect = hero.getBoundingClientRect();
			targetMouseX = e.clientX - rect.left;
			targetMouseY = e.clientY - rect.top;
		});

		document.addEventListener('mouseleave', () => {
			targetMouseX = -200;
			targetMouseY = -200;
		});

		function draw() {
			ctx.clearRect(0, 0, w, h);

			mouseX += (targetMouseX - mouseX) * 0.05;
			mouseY += (targetMouseY - mouseY) * 0.05;

			const isDark = document.documentElement.classList.contains('dark');
			const baseColor = isDark ? '120, 165, 245' : '255, 255, 255';

			for (let i = 0; i < particles.length; i++) {
				const p = particles[i];

				p.x += p.vx;
				p.y += p.vy;

				if (p.y < -20) { p.y = h + 10; p.x = Math.random() * w; }
				if (p.y > h + 20) { p.y = -10; p.x = Math.random() * w; }
				if (p.x < -20) p.x = w + 10;
				if (p.x > w + 20) p.x = -10;

				const dx = mouseX - p.x;
				const dy = mouseY - p.y;
				const distToMouse = Math.sqrt(dx * dx + dy * dy);
				if (distToMouse < 200) {
					p.x -= (dx / distToMouse) * 0.3;
					p.y -= (dy / distToMouse) * 0.3;
				}

				if (p.shape === 'diamond') {
					ctx.save();
					ctx.translate(p.x, p.y);
					ctx.rotate(Math.PI / 4);
					ctx.fillStyle = `rgba(${baseColor}, ${p.opacity * 0.7})`;
					ctx.fillRect(-p.size * 0.7, -p.size * 0.7, p.size * 1.4, p.size * 1.4);
					ctx.restore();
				} else {
					ctx.beginPath();
					ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
					ctx.fillStyle = `rgba(${baseColor}, ${p.opacity})`;
					ctx.fill();
				}

				for (let j = i + 1; j < particles.length; j++) {
					const q = particles[j];
					const ddx = p.x - q.x;
					const ddy = p.y - q.y;
					const dist = Math.sqrt(ddx * ddx + ddy * ddy);
					if (dist < connectionDist) {
						const lineAlpha = (1 - dist / connectionDist) * 0.1;
						ctx.beginPath();
						ctx.moveTo(p.x, p.y);
						ctx.lineTo(q.x, q.y);
						ctx.strokeStyle = `rgba(${baseColor}, ${lineAlpha})`;
						ctx.lineWidth = 0.5;
						ctx.stroke();
					}
				}
			}

			requestAnimationFrame(draw);
		}

		resize();
		draw();

		window.addEventListener('resize', resize);

		document.addEventListener('astro:after-swap', () => {
			resize();
		});
	}
</script>
