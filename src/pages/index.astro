---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScatteredLogo from '../components/ScatteredLogo.astro';
import PatternBand from '../components/PatternBand.astro';
import ProfileDetails from '../components/ProfileDetails.astro';
---
<BaseLayout title="Feixiang Tao">
  <section class="hero-composition home-introduction" aria-labelledby="home-title">
    <header class="hero-intro">
      <p class="intro-kicker">TensorFieldX / About me</p>
      <h1 id="home-title">Hi, I’m<br /><span>Feixiang Tao.</span></h1>
      <p class="intro-affiliation">Artificial Intelligence · SUSTech · Shenzhen</p>
      <div class="hero-copy">
        <p>I’m an undergraduate at Southern University of Science and Technology, interested in how learning agents reason, plan, and make reliable decisions.</p>
        <p>I am interested in reinforcement learning and long-horizon planning, and in the theory that explains why modern learning systems work.</p>
      </div>
      <div class="intro-contact" aria-label="Profile and contact links"><a href="#profile-details">More about me ↓</a><a href="/cv/Feixiang-Tao-CV.pdf" target="_blank" rel="noopener noreferrer">CV ↗</a><a href="mailto:12512619@mail.sustech.edu.cn">Email ↗</a><a href="https://github.com/kevin258258" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
    </header>
    <div class="hero-art"><ScatteredLogo />
      <span class="hero-caption hero-caption--1">Learning to reason, plan, and act.</span>
      <span class="hero-caption hero-caption--2">From first principles to experiments.</span>
      <span class="hero-caption hero-caption--3">Physics, mathematics, and computer science.</span>
      <span class="hero-caption hero-caption--4">A space for ideas and questions.</span>
    </div>
  </section>
  <section aria-labelledby="about-title">
    <div class="reference-section-heading"><h2 id="about-title">About</h2><PatternBand /></div>
    <ProfileDetails />
  </section>
</BaseLayout>
