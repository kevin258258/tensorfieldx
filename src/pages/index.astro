---
import BaseLayout from '../layouts/BaseLayout.astro';
import Emblem from '../components/motion/Emblem.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { getCollection } from 'astro:content';
import { buildSeriesList } from '../lib/series';

const allNotes = await getCollection('notes');
const allPosts = await getCollection('blog');
const seriesEntries = await getCollection('series');

const seriesList = buildSeriesList(seriesEntries, allNotes);
const featured = seriesList.filter((s) => s.featured).slice(0, 3);
const seriesTitle = new Map(seriesList.map((s) => [s.slug, s.title]));

const recent = allNotes
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6)
	.map((n) => ({
		slug: n.slug,
		title: n.data.title,
		date: n.data.pubDate.toISOString().split('T')[0],
		series: n.data.series ? seriesTitle.get(n.data.series) ?? n.data.series : null,
	}));

const postCount = allPosts.filter((p) => !p.data.draft).length;
---

<BaseLayout title="Home">

	<!-- Hero: the emblem itself is the visual anchor -->
	<section class="relative overflow-hidden">
		<span class="absolute left-4 top-4 font-mono text-xs text-accent-warm select-none" aria-hidden="true">+</span>
		<span class="absolute right-4 bottom-4 font-mono text-xs text-accent-warm select-none" aria-hidden="true">+</span>

		<div class="max-w-6xl mx-auto px-6 pt-14 md:pt-20 pb-16 grid grid-cols-1 md:grid-cols-[1.15fr_1fr] gap-10 items-center">
			<div>
				<p class="font-mono text-[11px] tracking-[0.25em] text-accent-warm" data-animate="fade-in">
					FEIXIANG TAO — PERSONAL ARCHIVE
				</p>
				<div class="border-t-2 border-primary mt-5 pt-8" data-animate="fade-up">
					<h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-bold leading-[1.02] tracking-tight text-primary">
						A personal archive<br />of <span class="italic text-accent">deep learning</span>.
					</h1>
				</div>
				<p class="mt-6 font-body text-base md:text-lg text-secondary leading-relaxed max-w-md" data-animate="fade-up">
					Course notes, derivations and experiments across physics, mathematics and computer science.
				</p>
				<div class="mt-8 font-mono text-[11px] text-muted tracking-widest" data-animate="fade-in">
					{allNotes.length} NOTES · {postCount} POST · EST. 2025 · SHENZHEN
				</div>
			</div>
			<div class="hero-emblem hidden md:block" aria-hidden="true" data-animate="scale-in">
				<Emblem />
			</div>
		</div>
	</section>

	<!-- Featured series -->
	<section class="relative border-t border-edge">
		<div class="max-w-6xl mx-auto px-6 py-16">
			<div class="flex items-baseline justify-between" data-animate="fade-up">
				<h2 class="font-mono text-[11px] tracking-[0.25em] text-accent-warm">FEATURED SERIES ▸▸</h2>
				<a href="/notes" data-transition="section" class="font-sans text-sm text-accent hover:underline underline-offset-4">
					全部系列
				</a>
			</div>
			<div class="shelf-grid mt-8" data-animate="fade-up">
				{featured.map((s, i) => (
					<SeriesCard series={s} index={i} lead={i === 0} />
				))}
			</div>
		</div>
	</section>

	<!-- Recent updates -->
	<section class="border-t border-edge">
		<div class="max-w-6xl mx-auto px-6 py-16">
			<h2 class="font-mono text-[11px] tracking-[0.25em] text-accent-warm" data-animate="fade-up">
				RECENT — 最近更新
			</h2>
			<div class="mt-6 divide-y divide-edge" data-animate="stagger-fade-up">
				{recent.map((n) => (
					<a href={`/notes/${n.slug}`} data-transition="enter" class="group flex items-baseline gap-4 py-4 px-3 rounded transition-colors hover:bg-accent/5">
						<span class="font-mono text-[11px] text-muted w-24 shrink-0">{n.date}</span>
						<span data-fly-title class="font-body text-base text-primary group-hover:text-accent transition-colors flex-1">
							{n.title}
						</span>
						{n.series && (
							<span class="hidden md:inline font-sans text-[10px] text-muted">{n.series}</span>
						)}
					</a>
				))}
			</div>
		</div>
	</section>

</BaseLayout>
