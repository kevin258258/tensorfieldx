---
---

<span class="sidenote-wrapper group inline" data-state="closed">
    <button
        type="button"
        class="sidenote-trigger cursor-help text-accent text-[10px] align-super hover:underline decoration-accent/50 underline-offset-2 transition-all mx-0.5 outline-none"
        style="line-height: 0;"
        aria-label="Toggle note"
    >
        <span class="inline-flex items-center justify-center w-3.5 h-3.5 text-[9px] font-mono font-bold text-accent border border-accent/30 rounded-full
        group-data-[state=open]:bg-accent group-data-[state=open]:text-paper group-data-[state=open]:border-accent transition-all">*</span>
    </button>

    <span class="hidden xl:block absolute right-[-280px] top-0 w-[240px] z-20 pointer-events-none group-data-[state=open]:pointer-events-auto">
        <span class="block border-l-2 border-accent/30 pl-4 py-1 text-[12px] leading-relaxed font-body text-secondary text-left
        opacity-0 translate-x-[-8px] transition-all duration-300 ease-out
        group-data-[state=open]:opacity-100 group-data-[state=open]:translate-x-0">
            <slot />
        </span>
    </span>

    <span class="mobile-note hidden group-data-[state=open]:block xl:!hidden w-full mt-3 mb-4 pl-4 border-l-2 border-accent/20 font-body text-sm text-secondary leading-relaxed">
        <slot />
    </span>
</span>

<script>
    function setupSidenotes() {
        document.body.removeEventListener('click', handleSidenoteClick);
        document.body.addEventListener('click', handleSidenoteClick);
    }

    function handleSidenoteClick(e: MouseEvent) {
        const target = e.target as HTMLElement;
        const trigger = target.closest('.sidenote-trigger');
        if (trigger) {
            e.preventDefault();
            e.stopPropagation();
            const wrapper = trigger.closest('.sidenote-wrapper');
            if (!wrapper) return;
            const currentState = wrapper.getAttribute('data-state');
            wrapper.setAttribute('data-state', currentState === 'open' ? 'closed' : 'open');
        }
    }

    setupSidenotes();
    document.addEventListener('astro:page-load', setupSidenotes);
</script>
