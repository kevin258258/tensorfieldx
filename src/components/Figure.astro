---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-8">
    <div class="rounded overflow-hidden border border-edge">
        <img
            src={src}
            alt={alt}
            class="w-full h-auto object-cover"
            loading="lazy"
        />
    </div>
    {caption && (
        <figcaption class="mt-2 text-center text-xs font-sans text-muted italic">
            {caption}
        </figcaption>
    )}
</figure>
