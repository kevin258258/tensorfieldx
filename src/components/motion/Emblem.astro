---
/**
 * Geometric emblem — the recurring motion motif of the site.
 * Pure SVG markup; all styling/animation lives in src/styles/transitions.css.
 *
 * Layers (inner → outer):
 *   core pac-man + crosshair · 3 independent arcs · dot lane ·
 *   dashed ring · tick ring · solid ring · crosshair ticks · corner brackets
 */
---
<svg class="emblem" viewBox="0 0 100 100" aria-hidden="true">
  <g transform="translate(50,50)">
    <g class="emblem-cross">
      <path d="M-40 0h8 M32 0h8 M0 -40v8 M0 32v8" />
    </g>
    <g class="emblem-corners">
      <path d="M-44 -44h8 M-44 -44v8 M44 -44h-8 M44 -44v8 M-44 44h8 M-44 44v-8 M44 44h-8 M44 44v-8" />
    </g>
    <circle class="emblem-ring-outer" r="34" />
    <circle class="emblem-ticks" r="34" />
    <circle class="emblem-ring-dashed" r="29" />
    <g class="emblem-dots">
      <circle cx="25.5" cy="0" r="1.1" /><circle cx="18" cy="18" r="1.1" />
      <circle cx="0" cy="25.5" r="1.1" /><circle cx="-18" cy="18" r="1.1" />
      <circle cx="-25.5" cy="0" r="1.1" /><circle cx="-18" cy="-18" r="1.1" />
      <circle cx="0" cy="-25.5" r="1.1" /><circle cx="18" cy="-18" r="1.1" />
    </g>
    <circle class="emblem-arc-a" r="21.5" />
    <circle class="emblem-arc-b" r="15" />
    <circle class="emblem-arc-c" r="9.5" />
    <path class="emblem-core" d="M 0 0 L 5.63 -3.25 A 6.5 6.5 0 1 0 5.63 3.25 Z" />
    <path class="emblem-core-cross" d="M-2.8 0h5.6 M0 -2.8v5.6" />
  </g>
</svg>
