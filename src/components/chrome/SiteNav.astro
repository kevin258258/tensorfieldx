---
import ScatteredLogo from '../ScatteredLogo.astro';
import { getCollection } from 'astro:content';
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const notes = await getCollection('notes');
const posts = await getCollection('blog', ({ data }) => !data.draft);
const projects = await getCollection('projects');
const count = notes.length + posts.length + projects.length;
const isHome = currentPath === '/';
const isProfile = currentPath.startsWith('/about');
const isArchive = currentPath.startsWith('/archive');
---
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="viewport-frame" aria-hidden="true"></div>
<div class="local-time">local information: <time data-local-time>--:--</time> Shenzhen, CN</div>
<div class="color-palette" aria-label="Color palette">
  <span>color palette:</span>
  {['#7d97b8', '#dfb255', '#52a47e', '#9eaf92', '#a7b6b0', '#2a2927'].map((color, index) => (
    <button type="button" data-palette={index} style={`--swatch: ${color}`} aria-label={`Color ${index + 1}`} aria-pressed={index === 0}></button>
  ))}
</div>
<nav class:list={['reference-nav', { 'is-home': isHome, 'is-profile': isProfile, 'is-archive': isArchive }]} aria-label="Main navigation">
  <a href="/" class:list={['nav-logo', { 'nav-logo--pattern': isHome }]} aria-label="TensorFieldX home">
    {isHome ? <span class="nav-dot-pattern" aria-hidden="true" /> : <ScatteredLogo />}
  </a>
  <button type="button" class="sound-toggle" data-sound-toggle aria-label="Turn sound on" aria-pressed="false">
    <span>Sound</span>
    <svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="12" fill="currentColor" /><circle cx="14" cy="14" r="3.2" fill="var(--paper)" /><path d="M15 12 24 3" stroke="var(--paper)" stroke-width="3" /></svg>
  </button>
  <a href="/" class:list={['nav-page', 'nav-home', { 'is-active': isHome }]} aria-current={isHome ? 'page' : undefined}><span>Home</span></a>
  <a href="/about" class:list={['nav-page', 'nav-profile', { 'is-active': isProfile }]} aria-current={isProfile ? 'page' : undefined}><span>Profile</span></a>
  <a href="/archive" class="nav-archive" aria-label={`Browse archive, ${count} entries`} aria-current={isArchive ? 'page' : undefined}>
    <span>Archive</span><svg viewBox="0 0 26 26" aria-hidden="true"><path fill="currentColor" d="M0 0h5.2v5.2H0zm10.4 0h5.2v5.2h-5.2zm10.4 0H26v5.2h-5.2zM0 10.4h5.2v5.2H0zm10.4 0h5.2v5.2h-5.2zm10.4 0H26v5.2h-5.2zM0 20.8h5.2V26H0zm10.4 0h5.2V26h-5.2zm10.4 0H26V26h-5.2z" /></svg>
    <small>({count})</small>
  </a>
  {isArchive && <>
    <label class="nav-category-select"><span>Category Select</span><select data-archive-select aria-label="Select archive category">{['All', 'Blog', 'Notes', 'Projects'].map(category => <option value={category}>{category}</option>)}</select><span class="nav-category-arrow" aria-hidden="true">⌄</span></label>
    <a href="/" class="nav-close" aria-label="Close archive and go home"><em>Archive</em><span>Close</span><b aria-hidden="true">×</b></a>
  </>}
</nav>
