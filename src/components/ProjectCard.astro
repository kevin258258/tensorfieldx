---
interface Props {
  title: string;
  description: string;
  tags: string[];
  status: 'dev' | 'stable' | 'archived';
  github?: string;
  demo?: string;
}

const { title, description, tags, status, github, demo } = Astro.props;

const statusStyles = {
    dev: { color: "text-amber-600 dark:text-amber-400", bg: "bg-amber-500/10", label: "In Development" },
    stable: { color: "text-accent", bg: "bg-accent/10", label: "Stable" },
    archived: { color: "text-muted", bg: "bg-primary/5", label: "Archived" }
};

const s = statusStyles[status];
---

<article class="group flex flex-col h-full border border-edge rounded-lg overflow-hidden hover:border-accent/30 transition-all">
    <div class="p-6 flex flex-col h-full">

        <div class="flex justify-between items-start mb-3">
            <h3 class="text-lg font-display font-bold text-primary group-hover:text-accent transition-colors">
                {title}
            </h3>
            <span class:list={["text-[10px] font-sans font-medium px-2 py-0.5 rounded", s.color, s.bg]}>
                {s.label}
            </span>
        </div>

        <p class="text-secondary font-body text-sm leading-relaxed mb-6 flex-grow">
            {description}
        </p>

        <div class="mt-auto space-y-4">
            <div class="flex flex-wrap gap-1.5">
                {tags.map(tag => (
                    <span class="text-[10px] font-sans text-muted border border-edge px-1.5 py-0.5 rounded">
                        {tag}
                    </span>
                ))}
            </div>

            <div class="flex items-center gap-4 pt-3 border-t border-edge">
                {github && (
                    <a href={github} target="_blank" class="flex items-center gap-1.5 text-xs font-sans text-secondary hover:text-accent transition-colors">
                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                        Source
                    </a>
                )}
                {demo && (
                    <a href={demo} target="_blank" class="flex items-center gap-1.5 text-xs font-sans text-secondary hover:text-accent transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
                        Demo
                    </a>
                )}
                {!github && !demo && (
                    <span class="text-[10px] font-sans text-muted">Private</span>
                )}
            </div>
        </div>
    </div>
</article>
