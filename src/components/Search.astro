<dialog id="search-modal" class="archive-search" aria-labelledby="search-title">
  <div class="search-heading"><h2 id="search-title">Search the archive</h2><button type="button" data-search-close aria-label="Close search">Close ×</button></div>
  <label class="search-input-wrap"><span class="sr-only">Search posts and topics</span><input type="search" id="search-input" placeholder="Search articles or topics…" autocomplete="off" /></label>
  <div id="search-results" aria-live="polite"><p class="search-message">Type to search titles, descriptions, and topics.</p></div>
  <div class="search-footer"><span id="result-count">0 results</span><span>Ctrl / ⌘ K · Esc to close</span></div>
</dialog>

<script>
  interface SearchItem { url: string; title: string; description: string; tags: string[]; date: string; }
  let indexPromise: Promise<SearchItem[]> | undefined;
  let controller: AbortController | undefined;

  function loadIndex() {
    indexPromise ??= fetch('/link-preview.json').then(response => {
      if (!response.ok) throw new Error('Search index unavailable');
      return response.json();
    }).then(data => Object.entries(data).map(([url, meta]) => ({ url, ...(meta as Omit<SearchItem, 'url'>) }))).catch(error => {
      indexPromise = undefined;
      throw error;
    });
    return indexPromise;
  }

  function initSearchSystem() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const modal = document.querySelector<HTMLDialogElement>('#search-modal');
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const results = document.querySelector<HTMLElement>('#search-results');
    const count = document.querySelector<HTMLElement>('#result-count');
    if (!modal || !input || !results || !count) return;
    let trigger: HTMLElement | null = null;
    let request = 0;
    const fitViewport = () => {
      const viewport = window.visualViewport;
      if (!viewport || !modal.open) return;
      modal.style.setProperty('--search-top', `${viewport.offsetTop + 16}px`);
      modal.style.setProperty('--search-height', `${Math.max(0, viewport.height - 32)}px`);
    };
    window.visualViewport?.addEventListener('resize', fitViewport, { signal });
    window.visualViewport?.addEventListener('scroll', fitViewport, { signal });

    function message(text: string) {
      const paragraph = document.createElement('p');
      paragraph.className = 'search-message';
      paragraph.textContent = text;
      results!.replaceChildren(paragraph);
      count!.textContent = '0 results';
    }
    async function search() {
      const id = ++request;
      const query = input!.value.trim().toLocaleLowerCase();
      if (!query) { message('Type to search titles, descriptions, and topics.'); return; }
      try {
        const index = await loadIndex();
        if (signal.aborted || id !== request) return;
        const terms = query.split(/\s+/);
        const hits = index.filter(item => terms.every(term => `${item.title} ${item.description} ${item.tags.join(' ')}`.toLocaleLowerCase().includes(term))).sort((a, b) => b.date.localeCompare(a.date));
        if (!hits.length) { message('No results. Try another title or topic.'); return; }
        results!.replaceChildren();
        count!.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'}`;
        hits.forEach(item => {
          const link = document.createElement('a');
          link.href = item.url;
          const title = document.createElement('strong');
          title.textContent = item.title;
          const description = document.createElement('p');
          description.textContent = item.description;
          const meta = document.createElement('small');
          meta.textContent = `${item.date} · ${item.url.startsWith('/notes/') ? 'Notes' : 'Blog'} · ${item.tags.slice(0, 3).join(' / ')}`;
          link.append(title, description, meta);
          results!.append(link);
        });
      } catch {
        if (!signal.aborted && id === request) message('Search could not load. Please try again.');
      }
    }
    const open = () => {
      trigger = document.activeElement as HTMLElement;
      if (!modal.open) modal.showModal();
      fitViewport();
      input.focus();
      void search();
    };
    document.querySelectorAll<HTMLElement>('[data-search-trigger]').forEach(button => button.addEventListener('click', open, { signal }));
    modal.querySelector('[data-search-close]')?.addEventListener('click', () => modal.close(), { signal });
    modal.addEventListener('click', event => { if (event.target === modal) modal.close(); }, { signal });
    modal.addEventListener('close', () => { request++; input.value = ''; message('Type to search titles, descriptions, and topics.'); trigger?.focus(); }, { signal });
    input.addEventListener('input', () => void search(), { signal });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && modal.open) { event.preventDefault(); modal.close(); }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); modal.open ? modal.close() : open(); }
    }, { signal });
    document.addEventListener('astro:before-swap', () => { if (modal.open) modal.close(); controller?.abort(); }, { once: true, signal });
  }
  document.addEventListener('astro:page-load', initSearchSystem);
  initSearchSystem();
</script>
