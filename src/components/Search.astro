<div id="search-modal" class="fixed inset-0 z-[999] bg-primary/20 backdrop-blur-sm hidden flex items-start justify-center pt-[20vh] opacity-0 transition-opacity duration-200">

    <div class="w-full max-w-xl bg-paper border border-edge shadow-xl rounded-lg transform scale-95 transition-transform duration-200 mx-4" id="search-panel">

        <div class="flex items-center gap-3 border-b border-edge p-4">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
            <input type="text" id="search-input" placeholder="Search notes..."
                   class="bg-transparent border-none outline-none text-primary font-body text-base w-full placeholder-muted focus:ring-0" autocomplete="off" />
            <kbd class="hidden md:block text-[10px] text-muted font-mono border border-edge px-1.5 py-0.5 rounded">ESC</kbd>
        </div>

        <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2 space-y-0.5">
            <div class="p-8 text-center text-muted font-sans text-sm" id="empty-state">
                Type to search...
            </div>
        </div>

        <div class="border-t border-edge px-4 py-2 text-[11px] font-mono text-muted flex justify-between">
             <span id="result-count">0 results</span>
        </div>
    </div>
</div>

<script>
    interface SearchItem {
        url: string;
        title: string;
        description?: string;
        tags: string[];
        date: string;
    }

    let searchIndex: SearchItem[] = [];
    let isDataLoaded = false;

    function initSearchSystem() {
        const modal = document.getElementById('search-modal');
        const panel = document.getElementById('search-panel');
        const input = document.getElementById('search-input') as HTMLInputElement;
        const resultsContainer = document.getElementById('search-results');
        const emptyState = document.getElementById('empty-state');
        const resultCount = document.getElementById('result-count');
        const triggers = document.querySelectorAll('#search-trigger');

        if (!modal || !panel || !input || !resultsContainer) return;

        async function loadIndex() {
            if (isDataLoaded) return;
            try {
                const res = await fetch('/link-preview.json');
                const data = await res.json();
                searchIndex = Object.entries(data).map(([url, meta]: [string, any]) => ({
                    url,
                    ...meta
                }));
                isDataLoaded = true;
            } catch (e) {
                console.error("Index Load Failed", e);
            }
        }

        function performSearch(query: string) {
            if (!resultsContainer) return;
            if (!query) {
                resultsContainer.innerHTML = '';
                if(emptyState) resultsContainer.appendChild(emptyState);
                if(resultCount) resultCount.innerText = '0 results';
                return;
            }

            const lowerQuery = query.toLowerCase();
            const hits = searchIndex.filter(item =>
                item.title.toLowerCase().includes(lowerQuery) ||
                item.tags.some((tag: string) => tag.toLowerCase().includes(lowerQuery))
            );

            renderResults(hits);
        }

        function renderResults(hits: SearchItem[]) {
            if (!resultsContainer) return;
            resultsContainer.innerHTML = '';
            if(resultCount) resultCount.innerText = `${hits.length} result${hits.length !== 1 ? 's' : ''}`;

            if (hits.length === 0) {
                resultsContainer.innerHTML = '<div class="p-6 text-center text-muted font-sans text-sm">No results found</div>';
                return;
            }

            hits.forEach(item => {
                const el = document.createElement('a');
                el.href = item.url;
                el.className = 'block px-3 py-2.5 rounded-md hover:bg-accent/8 group transition-all';
                el.innerHTML = `
                    <div class="flex justify-between items-baseline mb-0.5">
                        <span class="font-body text-base text-primary group-hover:text-accent transition-colors">${item.title}</span>
                        <span class="font-mono text-[10px] text-muted ml-4 shrink-0">${item.date}</span>
                    </div>
                    <div class="font-mono text-[10px] text-muted flex gap-2 mt-1">
                        ${item.tags.slice(0, 3).map((t: string) => `<span>#${t}</span>`).join('')}
                    </div>
                `;
                resultsContainer.appendChild(el);
            });
        }

        function openModal() {
            loadIndex();
            modal?.classList.remove('hidden');
            requestAnimationFrame(() => {
                modal?.classList.remove('opacity-0');
                panel?.classList.remove('scale-95');
            });
            setTimeout(() => input?.focus(), 50);
        }

        function closeModal() {
            modal?.classList.add('opacity-0');
            panel?.classList.add('scale-95');
            setTimeout(() => modal?.classList.add('hidden'), 200);
            if(input) input.value = '';
            performSearch('');
        }

        triggers.forEach((t) => {
            // @ts-ignore
            t.onclick = (e) => { e.preventDefault(); openModal(); };
        });

        document.addEventListener('keydown', (e: KeyboardEvent) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openModal(); }
            if (e.key === 'Escape') { closeModal(); }
        });

        modal.onclick = (e) => { if (e.target === modal) closeModal(); };
        input.oninput = (e) => { performSearch((e.target as HTMLInputElement).value); };
    }

    initSearchSystem();
</script>
