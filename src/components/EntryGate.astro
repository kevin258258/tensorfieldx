<dialog id="entry-gate" class="entry-gate" aria-labelledby="entry-welcome">
  <div class="entry-frame" aria-hidden="true"></div>
  <div class="entry-gate-content">
    <p id="entry-welcome">Welcome to TensorFieldX.</p>
    <p>This website plays background music.</p>
    <p>Please select “off” if you would<br /> rather not listen to the background music.</p>
    <div class="entry-buttons">
      <button type="button" data-enter-sound="on" aria-label="Enter the site with sound on"><span>Sound</span><strong>On</strong></button>
      <button type="button" data-enter-sound="off" aria-label="Enter the site with sound off"><span>Sound</span><strong>Off</strong></button>
    </div>
  </div>
</dialog>
