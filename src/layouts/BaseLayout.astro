---
import "../styles/tokens.css";
import "../styles/transitions.css";
import "../styles/cards.css";
import "@fontsource/playfair-display/400-italic.css";
import "@fontsource/playfair-display/700.css";
import "@fontsource/playfair-display/700-italic.css";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/600.css";
import "@fontsource/jetbrains-mono/400.css";
import Search from "../components/Search.astro";
import LinkPreview from "../components/LinkPreview.astro";
import SiteNav from "../components/chrome/SiteNav.astro";
import SiteFooter from "../components/chrome/SiteFooter.astro";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  needsKatex?: boolean;
}

const { title, needsKatex = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="h-full w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <Analytics />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Feixiang Tao</title>
    <ClientRouter fallback="swap" />

    <script is:inline>
      (function () {
        function applyTheme(root) {
          var theme = localStorage.getItem('theme');
          var isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
          root.classList.toggle('dark', isDark);
        }

        applyTheme(document.documentElement);
        document.addEventListener('astro:before-swap', function (event) {
          applyTheme(event.newDocument.documentElement);
        });
      })();
    </script>

    {needsKatex && (
      <link
        rel="stylesheet"
        href="/vendor/katex/katex.min.css"
      />
    )}
  </head>

  <body class="text-primary min-h-screen font-body relative w-full max-w-full overflow-x-hidden">
    <div class="page-background" aria-hidden="true"></div>

    <Search />
    <LinkPreview />

    <div class="relative z-10 min-h-screen flex flex-col w-full max-w-full">
      <SiteNav currentPath={currentPath} />

      <main class="page-shell flex-1 w-full max-w-full">
        <slot />
      </main>

      <SiteFooter />
    </div>

    <script>
      import { initReveal } from "../scripts/reveal";
      import { initCopyCode } from "../scripts/copyCode";
      import { initLightbox } from "../scripts/lightbox";
      import { initTransitions } from "../scripts/transitions";

      function setupPageUi() {
        initReveal();
        initCopyCode();
        initLightbox();
      }

      document.addEventListener("astro:page-load", setupPageUi);
      setupPageUi();
      initTransitions();
    </script>
  </body>
</html>
