---
import "../styles/tokens.css";
import "../styles/transitions.css";
import "../styles/cards.css";
import "../styles/reference.css";
import "../styles/blog-ui.css";
import "../styles/reading.css";
import "@fontsource/jetbrains-mono/400.css";
import Search from "../components/Search.astro";
import LinkPreview from "../components/LinkPreview.astro";
import SiteNav from "../components/chrome/SiteNav.astro";
import SiteFooter from "../components/chrome/SiteFooter.astro";
import ReferencePointer from "../components/ReferencePointer.astro";
import PageCover from "../components/PageCover.astro";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  needsKatex?: boolean;
  lang?: string;
  alternates?: { lang: string; href: string }[];
}

const { title, needsKatex = false, lang = 'en', alternates = [] } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang} class="h-full w-full max-w-full" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <Analytics />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Feixiang Tao</title>
    {alternates.map(alternate => <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />)}
    <ClientRouter fallback="swap" />

    <script is:inline>
      (function () {
        function applyTheme(root) {
          var colors = ['125 151 184', '223 178 85', '82 164 126', '158 175 146', '167 182 176', '42 41 39'];
          var index = 5;
          try { index = Number(localStorage.getItem('palette') ?? 5); } catch (_) {}
          if (!colors[index]) index = 5;
          var color = colors[index];
          root.dataset.palette = String(index);
          root.style.setProperty('--ink', 'rgb(' + color + ')');
          ['primary', 'secondary', 'muted', 'accent', 'border'].forEach(function (name) {
            root.style.setProperty('--color-' + name, color);
          });
        }

        applyTheme(document.documentElement);
        document.addEventListener('astro:before-swap', function (event) {
          applyTheme(event.newDocument.documentElement);
        });
      })();
    </script>

    {needsKatex && (
      <link
        rel="stylesheet"
        href="/vendor/katex/katex.min.css"
      />
    )}
  </head>

  <body class="site-body text-primary min-h-screen font-body relative w-full max-w-full overflow-x-hidden">
    <div class="page-background" aria-hidden="true"></div>

    <Search />
    <LinkPreview />
    <ReferencePointer />
    <PageCover />

    <div class="site-wrapper relative z-10 min-h-screen flex flex-col">
      <SiteNav currentPath={currentPath} />

      <main id="main-content" class="page-shell flex-1 w-full max-w-full">
        <slot />
      </main>

      <SiteFooter />
    </div>

    <script>
      import { initReveal } from "../scripts/reveal";
      import { initCopyCode } from "../scripts/copyCode";
      import { initLightbox } from "../scripts/lightbox";
      import { initTransitions } from "../scripts/transitions";
      import { initReferenceUi } from "../scripts/reference";
      import { initArticleReader } from "../scripts/articleReader";

      function setupPageUi() {
        initReveal();
        initCopyCode();
        initLightbox();
        initReferenceUi();
        initArticleReader();
      }

      document.addEventListener("astro:page-load", setupPageUi);
      setupPageUi();
      initTransitions();
    </script>
  </body>
</html>
