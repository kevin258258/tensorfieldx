---
import "../styles/tokens.css";
import "../styles/transitions.css";
import "../styles/cards.css";
import "@fontsource/playfair-display/400-italic.css";
import "@fontsource/playfair-display/700.css";
import "@fontsource/playfair-display/700-italic.css";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/600.css";
import "@fontsource/jetbrains-mono/400.css";
import Search from "../components/Search.astro";
import LinkPreview from "../components/LinkPreview.astro";
import SiteNav from "../components/chrome/SiteNav.astro";
import SiteFooter from "../components/chrome/SiteFooter.astro";
import Emblem from "../components/motion/Emblem.astro";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  needsKatex?: boolean;
}

const { title, needsKatex = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="h-full w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <Analytics />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Feixiang Tao</title>
    <ClientRouter fallback="swap" />

    {needsKatex && (
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
        media="print"
        onload="this.media='all'"
      />
    )}
  </head>

  <body class="text-primary min-h-screen font-body relative w-full max-w-full overflow-x-hidden">
    <div class="page-background" aria-hidden="true"></div>

    <Search />
    <LinkPreview />

    <div class="relative z-10 min-h-screen flex flex-col w-full max-w-full">
      <SiteNav currentPath={currentPath} />

      <main class="page-shell flex-1 w-full max-w-full">
        <slot />
      </main>

      <button
        id="back-to-top"
        class="ui-fab fixed bottom-6 left-6 z-40 p-3 md:p-2.5 rounded-full bg-surface border border-edge shadow-lg text-muted hover:text-accent hover:border-accent/40 opacity-0 translate-y-4 pointer-events-none"
        aria-label="Back to top"
      >
        <svg class="w-5 h-5 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M5 15l7-7 7 7"/>
        </svg>
      </button>

      <SiteFooter />
    </div>

    <div id="page-transition-overlay" transition:persist aria-hidden="true">
      <div class="t-overlay-bg"></div>
      <div class="t-emblem-wrap">
        <Emblem />
      </div>
    </div>

    <script>
      import { initReveal } from "../scripts/reveal";
      import { initCopyCode } from "../scripts/copyCode";
      import { initTransitions } from "../scripts/transitions";

      let backToTopTicking = false;
      let backToTopScrollBound = false;

      const syncBackToTopVisibility = () => {
        const topBtn = document.getElementById("back-to-top");
        if (!topBtn) return;

        if (window.scrollY > 400) {
          topBtn.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
          topBtn.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
        } else {
          topBtn.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
          topBtn.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
        }
      };

      const bindBackToTop = () => {
        const topBtn = document.getElementById("back-to-top");
        if (!topBtn) return;

        if (!backToTopScrollBound) {
          window.addEventListener(
            "scroll",
            () => {
              if (backToTopTicking) return;
              backToTopTicking = true;
              requestAnimationFrame(() => {
                syncBackToTopVisibility();
                backToTopTicking = false;
              });
            },
            { passive: true },
          );
          backToTopScrollBound = true;
        }

        syncBackToTopVisibility();
        topBtn.onclick = () => window.scrollTo({ top: 0, behavior: "smooth" });
      };

      function setupPageUi() {
        initReveal();
        initCopyCode();
        bindBackToTop();
      }

      document.addEventListener("astro:page-load", setupPageUi);
      setupPageUi();
      initTransitions();
    </script>
  </body>
</html>
